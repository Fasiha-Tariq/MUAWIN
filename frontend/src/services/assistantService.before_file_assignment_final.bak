import {
  ActionType,
  WorkflowItem,
  WorkflowStep,
  Course,
} from '../types';
import { api } from './api';

export interface InterpretationResult {
  intent: ActionType;
  isMultiAction?: boolean;
  detectedActionsList?: string[];

  courseCode: string;
  courseName: string;
  courseId: string;

  source: string;
  action: string;
  confidence: number;

  /**
   * IMPORTANT:
   * For multi-action commands this should contain
   * only the instruction belonging to this action.
   */
  rawInstruction: string;

  suggestedTitle: string;
  suggestedSteps: WorkflowStep[];
  suggestedPayload: Record<string, any>;

  /**
   * Used by workflowService.ts and AppContext.tsx
   * to route the workflow to the correct backend.
   */
  workflowType: 'lecture' | 'assignment' | string;
}

/**
 * Backend response for a single workflow.
 */
interface BackendInterpretation {
  intent: string;

  workflow_type?: 'lecture' | 'assignment' | 'multi' | string;

  /**
   * Backend may provide an action-specific instruction.
   * This is especially important for multi-action commands.
   */
  raw_instruction?: string;

  course?: string;
  week?: number;
  lecture?: string;
  heading?: string | null;

  // Assignment-specific fields
  title?: string | null;
  marks?: number | null;
  deadline?: string | null;

  question_types?: Record<string, number> | null;

  source?: {
    week?: number | null;
    lecture?: number | null;
    name?: string | null;
  } | string | null;
}

/**
 * Backend response for a multi-action instruction.
 */
interface BackendMultiActionInterpretation {
  intent: string;

  workflow_type?: 'multi' | string;

  is_multi_action?: boolean;

  detected_actions?: string[];

  actions?: BackendInterpretation[];

  raw_instruction?: string;
}

type BackendResponse =
  | BackendInterpretation
  | BackendMultiActionInterpretation;

/**
 * Check whether a backend response contains
 * multiple requested workflows.
 */
function isBackendMultiAction(
  result: BackendResponse
): result is BackendMultiActionInterpretation {
  return (
    result.workflow_type === 'multi' ||
    ('is_multi_action' in result && result.is_multi_action === true) ||
    ('actions' in result && Array.isArray(result.actions))
  );
}

/**
 * Convert ONE backend interpretation into the
 * frontend structure expected by MUAWIN.
 */
function normalizeBackendInterpretation(
  result: BackendInterpretation,
  instruction: string,
  activeCourse?: Course | null
): InterpretationResult {
  /**
   * ------------------------------------------------------
   * WORKFLOW TYPE
   * ------------------------------------------------------
   */
  const workflowType =
    result.workflow_type ||
    (
      result.intent
        ?.toLowerCase()
        .includes('assignment')
        ? 'assignment'
        : 'lecture'
    );

  const isAssignment =
    workflowType === 'assignment';

  /**
   * ------------------------------------------------------
   * COURSE INFORMATION
   * ------------------------------------------------------
   */
  const courseName =
    result.course ||
    activeCourse?.title ||
    'Parallel and Distributed Computing';

  const courseCode =
    activeCourse?.code ||
    result.course ||
    'CS7 - PDC';

  const courseId =
    activeCourse?.id ||
    'cs7-pdc';

  /**
   * ------------------------------------------------------
   * LECTURE INFORMATION
   * ------------------------------------------------------
   */
  const lecture =
    result.lecture ||
    'Lecture Material';

  const week =
    result.week;

  /**
   * ------------------------------------------------------
   * ASSIGNMENT SOURCE INFORMATION
   * ------------------------------------------------------
   */
  const assignmentSource =
    typeof result.source === 'object' &&
    result.source !== null
      ? result.source
      : null;

  const sourceLecture =
    assignmentSource?.lecture ??
    null;

  const sourceWeek =
    assignmentSource?.week ??
    null;

  /**
   * ------------------------------------------------------
   * DETECT LECTURE UPLOAD
   * ------------------------------------------------------
   */
  const isUpload =
    !isAssignment &&
    (
      result.intent
        ?.toLowerCase()
        .includes('upload') ||
      instruction
        .toLowerCase()
        .includes('upload')
    );

  /**
   * ------------------------------------------------------
   * SUGGESTED TITLE
   * ------------------------------------------------------
   */
  let suggestedTitle: string;

  if (isAssignment) {
    suggestedTitle =
      result.title ||
      `${courseCode}: Assignment${
        week
          ? ` - Week ${week}`
          : ''
      }`;
  } else if (isUpload) {
    suggestedTitle =
      `${courseCode}: ${lecture}${
        week
          ? ` - Week ${week}`
          : ''
      }`;
  } else {
    suggestedTitle =
      `${courseCode}: ${
        result.intent ||
        'Workflow'
      }`;
  }

  /**
   * ------------------------------------------------------
   * BUILD WORKFLOW STEPS
   * ------------------------------------------------------
   */
  const suggestedSteps: WorkflowStep[] =
    isAssignment
      ? [
          {
            id: 1,
            title:
              'Understand teacher instruction',
            description:
              'Assignment instruction parsed by MUAWIN backend',
            status:
              'completed',
          },

          {
            id: 2,
            title:
              'Identify assignment source',
            description:
              sourceLecture
                ? `Use Lecture ${sourceLecture} as assignment content`
                : week
                  ? `Use Week ${week} lecture material as assignment content`
                  : 'Identify the requested lecture material',
            status:
              'completed',
          },

          {
            id: 3,
            title:
              'Generate assignment draft',
            description:
              result.question_types
                ? `Generate ${Object.entries(
                    result.question_types
                  )
                    .map(
                      ([type, count]) =>
                        `${count} ${type}`
                    )
                    .join(' + ')} questions`
                : 'Generate the requested assignment draft',
            status:
              'completed',
          },

          {
            id: 4,
            title:
              'Teacher Approval',
            description:
              'Teacher reviews and authorizes the assignment before any Moellim changes',
            status:
              'in_progress',
          },

          {
            id: 5,
            title:
              'Create assignment on Moellim',
            description:
              'Execute the approved assignment creation through controlled browser automation',
            status:
              'pending',
          },

          {
            id: 6,
            title:
              'Verify execution',
            description:
              'Verify that the assignment was successfully created on Moellim',
            status:
              'pending',
          },
        ]
      : [
          {
            id: 1,
            title:
              'Understand teacher instruction',
            description:
              'Instruction parsed by MUAWIN backend',
            status:
              'completed',
          },

          {
            id: 2,
            title:
              'Identify target course',
            description:
              `Target course: ${courseName}`,
            status:
              'completed',
          },

          {
            id: 3,
            title:
              'Prepare Moellim workflow',
            description:
              isUpload
                ? `Prepare ${lecture}${
                    week
                      ? ` for Week ${week}`
                      : ''
                  } for controlled upload`
                : 'Prepare the requested Moellim action',
            status:
              'completed',
          },

          {
            id: 4,
            title:
              'Teacher Approval',
            description:
              'Mandatory human authorization required before executing changes on Moellim',
            status:
              'in_progress',
          },

          {
            id: 5,
            title:
              'Execute approved workflow',
            description:
              'Execute the permitted browser automation workflow',
            status:
              'pending',
          },

          {
            id: 6,
            title:
              'Verify execution',
            description:
              'Verify that the requested action was successfully completed',
            status:
              'pending',
          },
        ];

  /**
   * ------------------------------------------------------
   * NORMALIZED RESULT
   * ------------------------------------------------------
   */
  return {
    intent:
      (
        result.intent ||
        (
          isAssignment
            ? 'Create Assignment'
            : 'Upload Lecture Notes'
        )
      ) as ActionType,

    isMultiAction:
      false,

    detectedActionsList: [
      result.intent ||
        (
          isAssignment
            ? 'Create Assignment'
            : 'Workflow'
        ),
    ],

    courseCode,

    courseName,

    courseId,

    source:
      isAssignment
        ? 'MUAWIN Backend - Assignment Workflow'
        : 'MUAWIN Backend',

    action:
      result.intent ||
      (
        isAssignment
          ? 'Create Assignment'
          : instruction
      ),

    confidence:
      1,

    /**
     * This is now ACTION-SPECIFIC.
     *
     * For a multi-action command:
     *
     * Lecture workflow:
     * "Upload Lecture 4 to CS7 MUAWIN Week 4"
     *
     * Assignment workflow:
     * "Create a 5 marks assignment..."
     */
    rawInstruction:
      instruction,

    suggestedTitle,

    suggestedSteps,

    workflowType,

    /**
     * Payload used by workflowService.ts
     * and AppContext.tsx.
     */
    suggestedPayload: {
      /**
       * IMPORTANT:
       * This contains the action-specific instruction.
       */
      instruction,

      /**
       * IMPORTANT:
       * This determines the backend workflow route.
       */
      workflowType,

      course:
        courseName,

      courseCode,

      courseId,

      week,

      lecture,

      heading:
        result.heading ||
        lecture,

      /**
       * Assignment information.
       */
      assignmentTitle:
        result.title ||
        suggestedTitle,

      marks:
        result.marks ??
        null,

      deadline:
        result.deadline ??
        null,

      questionTypes:
        result.question_types ??
        null,

      source:
        result.source ??
        null,

      sourceLecture,

      sourceWeek,
    },
  };
}

export const assistantService = {
  /**
   * ------------------------------------------------------
   * INTERPRET INSTRUCTION
   * ------------------------------------------------------
   *
   * For a single action:
   *
   *   Promise<InterpretationResult[]>
   *
   * For a combined command:
   *
   *   Promise<InterpretationResult[]>
   *
   * The frontend always receives a list.
   */
  async interpretInstruction(
    instruction: string,
    activeCourse?: Course | null
  ): Promise<InterpretationResult[]> {
    const trimmedInstruction =
      instruction.trim();

    if (!trimmedInstruction) {
      throw new Error(
        'Instruction cannot be empty.'
      );
    }

    /**
     * Send the original teacher instruction
     * to the backend interpreter.
     */
    const response =
      await api.post<BackendResponse>(
        '/assistant/interpret',
        {
          instruction: trimmedInstruction,
          course: activeCourse?.title || null,
          course_id: activeCourse?.id || null,
          course_code: activeCourse?.code || null,
        }
      );

    const result =
      response.data;

    /**
     * ------------------------------------------------------
     * MULTI-ACTION RESPONSE
     * ------------------------------------------------------
     */
    if (
      isBackendMultiAction(
        result
      )
    ) {
      const actions =
        result.actions || [];

      if (!actions.length) {
        throw new Error(
          'MUAWIN detected multiple actions, but no workflow actions were returned.'
        );
      }

      /**
       * Normalize each action independently.
       *
       * IMPORTANT FIX:
       *
       * Previously every action received:
       *
       *   trimmedInstruction
       *
       * which meant the lecture workflow could receive
       * the assignment instruction as well.
       *
       * Now we prefer:
       *
       *   action.raw_instruction
       *
       * and only fall back to the complete instruction
       * if the backend did not provide one.
       */
      return actions.map(
        (action) => {
          const actionInstruction =
            action.raw_instruction?.trim() ||
            trimmedInstruction;

          return normalizeBackendInterpretation(
            action,
            actionInstruction,
            activeCourse
          );
        }
      );
    }

    /**
     * ------------------------------------------------------
     * SINGLE-ACTION RESPONSE
     * ------------------------------------------------------
     */
    const singleResult =
      result as BackendInterpretation;

    const singleInstruction =
      singleResult.raw_instruction?.trim() ||
      trimmedInstruction;

    return [
      normalizeBackendInterpretation(
        singleResult,
        singleInstruction,
        activeCourse
      ),
    ];
  },

  /**
   * ------------------------------------------------------
   * CREATE ONE FRONTEND WORKFLOW
   * ------------------------------------------------------
   */
  createWorkflowFromInterpretation(
    interp: InterpretationResult
  ): WorkflowItem {
    const id =
      'local-' +
      Math.floor(
        1000 +
          Math.random() * 9000
      );

    const nowStr =
      'Today, ' +
      new Date().toLocaleTimeString(
        [],
        {
          hour: '2-digit',
          minute: '2-digit',
        }
      );

    return {
      id,

      title:
        interp.suggestedTitle,

      actionType:
        interp.intent,

      /**
       * IMPORTANT:
       * Keep workflowType at the top level.
       *
       * workflowService.ts uses this to determine
       * whether the request goes to:
       *
       * /workflows/prepare
       *
       * OR:
       *
       * /assignment-workflows/prepare
       */
      workflowType:
        interp.workflowType as
          | 'lecture'
          | 'assignment',

      courseId:
        interp.courseId,

      courseCode:
        interp.courseCode,

      courseName:
        interp.courseName,

      source:
        interp.source,

      requestedBy:
        'Teacher Instruction',

      createdAt:
        nowStr,

      status:
        'waiting_approval',

      currentStepIndex:
        3,

      instructionText:
        interp.rawInstruction,

      detectedIntent: {
        intent:
          interp.intent,

        course:
          `${interp.courseCode} - ${interp.courseName}`,

        source:
          interp.source,

        action:
          interp.action,

        confidence:
          interp.confidence,
      },

      steps:
        interp.suggestedSteps,

      /**
       * Keep workflowType and instruction
       * inside payload as well.
       *
       * This makes the workflow self-contained
       * when passed to workflowService.ts.
       */
      payload: {
        ...interp.suggestedPayload,

        instruction:
          interp.rawInstruction,

        workflowType:
          interp.workflowType,
      },
    };
  },

  /**
   * ------------------------------------------------------
   * CREATE MULTIPLE FRONTEND WORKFLOWS
   * ------------------------------------------------------
   */
  createWorkflowsFromInterpretations(
    interpretations: InterpretationResult[]
  ): WorkflowItem[] {
    return interpretations.map(
      (interp) =>
        this.createWorkflowFromInterpretation(
          interp
        )
    );
  },
};

export default assistantService;
