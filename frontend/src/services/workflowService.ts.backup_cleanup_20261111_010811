/**
 * Detect a combined workflow before checking assignment keywords.
 *
 * Combined requests often contain the word "assignment", but they
 * must use /combined-workflows rather than /assignment-workflows.
 */
function isCombinedWorkflow(
  workflow?: Partial<WorkflowItem> | BackendWorkflow
): boolean {
  if (!workflow) {
    return false;
  }

  const item = workflow as any;

  const explicitType = String(
    item.workflow_type ||
      item.workflowType ||
      item.payload?.workflowType ||
      item.parsed?.workflow_type ||
      ''
  ).toLowerCase();

  if (explicitType === 'combined') {
    return true;
  }

  const actionType = String(
    item.actionType || ''
  ).toLowerCase();

  if (actionType.includes('combined')) {
    return true;
  }

  // Support combined workflow IDs returned by the backend.
  // The explicit workflow_type is the primary detection mechanism.
  const id = String(item.id || '');

  if (
    id.startsWith('cw-') ||
    id.startsWith('combined-')
  ) {
    return true;
  }

  // Fallback for a new instruction that requests both actions.
  const instruction = String(
    item.request ||
      item.instructionText ||
      item.payload?.instruction ||
      item.title ||
      ''
  ).toLowerCase();

  return (
    instruction.includes('assignment') &&
    (
      instruction.includes('upload lecture') ||
      instruction.includes('upload the lecture') ||
      instruction.includes('lecture upload')
    )
  );
}

/**
 * Determine whether this is an assignment-only workflow.
 */
function isAssignmentWorkflow(
  workflow?: Partial<WorkflowItem> | BackendWorkflow
): boolean {
  if (!workflow || isCombinedWorkflow(workflow)) {
    return false;
  }

  const item = workflow as any;

  const backendType = String(
    item.workflow_type || ''
  ).toLowerCase();

  if (
    backendType === 'assignment' ||
    backendType === 'create_assignment'
  ) {
    return true;
  }

  const frontendType = String(
    item.workflowType ||
      item.payload?.workflowType ||
      ''
  ).toLowerCase();

  if (
    frontendType === 'assignment' ||
    frontendType === 'create_assignment'
  ) {
    return true;
  }

  if (
    String(item.actionType || '')
      .toLowerCase()
      .includes('assignment')
  ) {
    return true;
  }

  const instruction = String(
    item.request ||
      item.instructionText ||
      item.title ||
      ''
  ).toLowerCase();

  return (
    instruction.includes('assignment') &&
    !instruction.includes('upload lecture')
  );
}

/**
 * Return the backend route prefix for a workflow.
 */
function getWorkflowBasePath(
  workflow?: Partial<WorkflowItem> | BackendWorkflow
): string {
  if (isCombinedWorkflow(workflow)) {
    return '/combined-workflows';
  }

  if (isAssignmentWorkflow(workflow)) {
    return '/assignment-workflows';
  }

  return '/workflows';
}

/**
 * Extract a course ID from a Moellim course URL.
 */
function extractCourseId(
  href?: string
): string | undefined {
  if (!href) {
    return undefined;
  }

  const match = href.match(/[?&]id=(\d+)/);

  return match?.[1];
}

/**
 * Format a backend timestamp for display.
 */
function formatBackendTime(
  value?: string
): string {
  if (!value) {
    return (
      'Today, ' +
      new Date().toLocaleTimeString([], {
        hour: '2-digit',
        minute: '2-digit',
      })
    );
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleTimeString([], {
    hour: '2-digit',
    minute: '2-digit',
  });
}

/**
 * Map backend workflow status to the frontend status type.
 */
function mapBackendStatus(
  backendStatus: string,
  fallback?: WorkflowItem['status']
): WorkflowItem['status'] {
  const statusMap: Record<
    string,
    WorkflowItem['status']
  > = {
    idle: 'idle',
    understanding: 'understanding',
    planned: 'planned',
    preparing: 'understanding',
    waiting_approval: 'waiting_approval',
    approved: 'approved',
    running: 'executing',
    executing: 'executing',
    verifying: 'verifying',
    completed: 'completed',
    failed: 'failed',
    rejected: 'rejected',
  };

  return (
    statusMap[backendStatus] ||
    fallback ||
    'waiting_approval'
  );
}

/**
 * Map backend execution steps to frontend steps.
 */
function createFrontendSteps(
  backend: BackendWorkflow,
  courseName: string,
  materialName?: string,
  assignmentWorkflow = false,
  combinedWorkflow = false
