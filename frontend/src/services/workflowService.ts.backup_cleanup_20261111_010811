  const backendSteps = backend.steps || [];

  if (backendSteps.length > 0) {
    return backendSteps.map((step, index) => ({
      id: index + 1,
      title: step.label,
      description: step.label,
      status:
        step.status === 'completed'
          ? 'completed'
          : step.status === 'waiting' ||
              step.status === 'running' ||
              step.status === 'in_progress'
            ? 'in_progress'
            : step.status === 'failed'
              ? 'failed'
              : 'pending',
