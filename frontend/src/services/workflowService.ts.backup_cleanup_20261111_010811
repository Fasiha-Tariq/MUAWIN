/**
 * Determine the current frontend step index.
 */
function calculateCurrentStepIndex(
  status: WorkflowItem['status']
): number {
  switch (status) {
    case 'waiting_approval':
      return 4;

    case 'approved':
      return 5;

    case 'executing':
      return 5;

    case 'verifying':
      return 6;

    case 'completed':
      return 6;

    case 'failed':
      return 6;

    case 'rejected':
      return 4;

    default:
      return 0;
  }
}

/**
 * Normalize the backend response without losing combined drafts.
 */
function normalizeWorkflow(
  backend: BackendWorkflow,
  fallback?: Partial<WorkflowItem>
): WorkflowItem {
  const parsed = backend.parsed || {};
  const course = backend.course || {};
  const draft = backend.draft || {};

  const combinedWorkflow =
    isCombinedWorkflow(backend) ||
    isCombinedWorkflow(fallback);

  const assignmentWorkflow =
    !combinedWorkflow &&
    (
      isAssignmentWorkflow(backend) ||
      fallback?.actionType === 'Create Assignment'
    );

  const lectureDraft =
    combinedWorkflow
      ? draft.lecture || {}
      : draft;

  const assignmentDraft =
    combinedWorkflow
      ? draft.assignment || null
      : assignmentWorkflow
        ? draft
        : null;

  const parsedLecture =
    parsed.lecture &&
    typeof parsed.lecture === 'object'
      ? parsed.lecture as Record<string, any>
      : {};

  const parsedAssignment =
    parsed.assignment &&
    typeof parsed.assignment === 'object'
      ? parsed.assignment
      : {};

  const courseName =
    course.name ||
    lectureDraft.course ||
    assignmentDraft?.course ||
    fallback?.courseName ||
    parsed.course ||
    parsedLecture.course ||
    parsedAssignment.course ||
    'Unknown Course';

  const courseCode =
    fallback?.courseCode ||
    parsed.course ||
    parsedLecture.course ||
    parsedAssignment.course ||
    courseName;

 const courseId =
  fallback?.courseId ||
  backend.course_id ||
  extractCourseId(course.href) ||
  '';

  const actionType =
    combinedWorkflow
      ? fallback?.actionType || 'Upload Lecture Notes'
      : fallback?.actionType ||
        (
          assignmentWorkflow
            ? 'Create Assignment'
            : 'Upload Lecture Notes'
        );

  const assignmentTitle =
    backend.title ||
    parsed.title ||
    parsedAssignment.title ||
    assignmentDraft?.title ||
    '';

  const title =
    fallback?.title ||
    (
      combinedWorkflow
        ? `Upload Lecture and Create Assignment`
        : assignmentWorkflow
          ? assignmentTitle || 'MUAWIN Assignment'
          : lectureDraft.heading ||
            parsedLecture.lecture ||
            (
              typeof parsed.lecture === 'string'
                ? parsed.lecture
                : undefined
            ) ||
            backend.request ||
            'MUAWIN Workflow'
    );

  const status = mapBackendStatus(
    backend.status,
    fallback?.status
  );

  const steps =
    fallback?.steps ||
    createFrontendSteps(
      backend,
      courseName,
      lectureDraft.file ||
        parsedLecture.lecture ||
        (
          typeof parsed.lecture === 'string'
            ? parsed.lecture
            : undefined
        ),
      assignmentWorkflow,
      combinedWorkflow
    );

  const verificationResult =
    backend.result
      ? {
          verifiedAt: formatBackendTime(
            backend.updatedAt
          ),
          moellimUrl:
            backend.result.assignment_url ||
            course.href,
          verificationStatus:
            backend.result.verified
              ? 'Verified' as const
              : 'Unverified' as const,
          notes:
            backend.result.message ||
            'Workflow result returned by Moellim automation.',
        }
      : fallback?.verificationResult;

  const existingPayload =
    fallback?.payload || {};

  const payload: Record<string, any> = {
    ...existingPayload,

    instruction:
      existingPayload.instruction ||
      backend.request,

    workflowType:
      combinedWorkflow
        ? 'combined'
        : assignmentWorkflow
          ? 'assignment'
          : 'lecture',

    course:
      existingPayload.course ||
      courseName,

    week:
      existingPayload.week ??
      lectureDraft.week ??
      parsedLecture.week ??
      parsed.week,

    lecture:
      existingPayload.lecture ||
      parsedLecture.lecture ||
      (
        typeof parsed.lecture === 'string'
          ? parsed.lecture
          : undefined
      ),

    heading:
      existingPayload.heading ||
      lectureDraft.heading,

    description:
      existingPayload.description ||
      lectureDraft.description,

    key_points:
      existingPayload.key_points ||
      lectureDraft.key_points ||
      [],

    assignmentTitle:
      existingPayload.assignmentTitle ||
      assignmentTitle ||
      undefined,

    assignmentDescription:
      existingPayload.assignmentDescription ||
      assignmentDraft?.description ||
      undefined,
    
    assignmentDraft:
      existingPayload.assignmentDraft ||
      assignmentDraft ||
      undefined,  

    marks:
      existingPayload.marks ??
      backend.marks ??
      parsed.marks ??
      parsedAssignment.marks ??
      assignmentDraft?.total_marks,

    deadline:
      existingPayload.deadline ||
      backend.deadline ||
      parsed.deadline ||
      parsedAssignment.deadline ||
      assignmentDraft?.deadline ||
      assignmentDraft?.due_date,

    questionTypes:
      existingPayload.questionTypes ||
      backend.question_types ||
      parsed.question_types ||
      parsedAssignment.question_types,

    source:
      existingPayload.source ||
      backend.source ||
      parsed.source ||
      parsedAssignment.source,

    sourceLecture:
      existingPayload.sourceLecture ??
      backend.source?.lecture ??
      parsed.source?.lecture ??
      parsedAssignment.source?.lecture,

    sourceWeek:
      existingPayload.sourceWeek ??
      backend.source?.week ??
      parsed.source?.week ??
      parsedAssignment.source?.week,

    // Preserve the complete combined drafts for the approval UI.
    combinedDraft: combinedWorkflow
      ? {
          lecture: lectureDraft,
          assignment: assignmentDraft,
        }
      : undefined,

    // Preserve raw backend data so UI updates don't discard fields.
    backendDraft: draft,
    backendParsed: parsed,
    backendResult: backend.result,
  };

  return {
    id: backend.id,
      workflowType:
      combinedWorkflow
        ? 'combined'
        : assignmentWorkflow
          ? 'assignment'
          : 'lecture',
    title,
    actionType,
    courseId,
    courseCode,
    courseName,

    source:
      fallback?.source ||
      'MUAWIN Backend',

    requestedBy:
      fallback?.requestedBy ||
      'Teacher Instruction',

    createdAt:
      fallback?.createdAt ||
      formatBackendTime(backend.createdAt),

    status,

    currentStepIndex:
      calculateCurrentStepIndex(status),

    instructionText:
      fallback?.instructionText ||
      backend.request,

    detectedIntent:
      fallback?.detectedIntent,

    steps,
    payload,
    verificationResult,
  };
}

export const workflowService = {
  /**
   * Retrieve lecture, assignment, and combined workflows.
   */
  async getWorkflows(): Promise<WorkflowItem[]> {
    const workflows: WorkflowItem[] = [];

    const endpoints = [
      '/workflows',
      '/assignment-workflows',
      '/combined-workflows',
    ];

    for (const endpoint of endpoints) {
      try {
        const response =
          await api.get<BackendWorkflow[]>(endpoint);

        if (Array.isArray(response.data)) {
          workflows.push(
            ...response.data.map((workflow) =>
              normalizeWorkflow(workflow)
            )
          );
        }
      } catch (error) {
        console.warn(
          `[WorkflowService] Could not retrieve ${endpoint}:`,
          error
        );
      }
    }

    return workflows.sort(
      (a, b) =>
        new Date(b.createdAt).getTime() -
        new Date(a.createdAt).getTime()
    );
  },

  /**
   * Retrieve one workflow from the correct backend.
   */
  async getWorkflowById(
    id: string
  ): Promise<WorkflowItem | undefined> {
    if (!id || id.startsWith('local-')) {
      return undefined;
    }

    const endpoints = [
      `/combined-workflows/${id}`,
      `/workflows/${id}`,
      `/assignment-workflows/${id}`,
    ];

    for (const endpoint of endpoints) {
      try {
        const response =
          await api.get<BackendWorkflow>(endpoint);

        if (response.data?.id) {
          return normalizeWorkflow(response.data);
        }
      } catch {
        // Continue to the next endpoint.
      }
    }

    console.error(
      `[WorkflowService] Could not retrieve workflow ${id}.`
    );

    return undefined;
  },

  /**
   * Prepare a lecture, assignment, or combined workflow.
   */
  async createWorkflow(
    workflow: Partial<WorkflowItem>
  ): Promise<WorkflowItem> {
    const instruction =
      workflow.instructionText ||
      String(
        workflow.payload?.instruction ||
        workflow.title ||
        ''
      );

    if (!instruction.trim()) {
      throw new Error(
        'Cannot create workflow: teacher instruction is empty.'
      );
    }

    const combined = isCombinedWorkflow({
      ...workflow,
      request: instruction,
    } as any);

    const assignment =
      !combined &&
      isAssignmentWorkflow(workflow);

    const endpoint = combined
      ? '/combined-workflows/prepare'
      : assignment
        ? '/assignment-workflows/prepare'
        : '/workflows/prepare';

    console.log(
      `[WorkflowService] Creating ${
        combined
          ? 'COMBINED'
          : assignment
            ? 'ASSIGNMENT'
            : 'LECTURE'
      } workflow via ${endpoint}`
    );

    const response =
      await api.post<BackendWorkflow>(
        endpoint,
        {
          instruction: instruction.trim(),
          course:
            (workflow.payload as any)?.course ||
            (workflow as any).course ||
            null,
          course_id:
            (workflow.payload as any)?.course_id ||
            (workflow as any).course_id ||
            null,
          course_code:
            (workflow.payload as any)?.course_code ||
            (workflow as any).course_code ||
            null,
        }
      );

    if (!response.data?.id) {
      throw new Error(
        'Backend did not return a workflow ID.'
      );
    }

    return normalizeWorkflow(
      response.data,
      {
        ...workflow,
        instructionText: instruction.trim(),

        // Never mark a combined workflow as assignment-only.
        actionType: combined
          ? workflow.actionType || 'Upload Lecture Notes'
          : assignment
            ? 'Create Assignment'
            : workflow.actionType,
      }
    );
  },

  /**
   * Approve a workflow.
   *
   * Combined approvals use:
   * heading, description, key_points,
   * assignment_title, assignment_description.
   */
  async approveWorkflow(
    id: string,
    editedPayload?: WorkflowApprovalPayload,
    workflow?: Partial<WorkflowItem>
  ): Promise<WorkflowItem | undefined> {
    if (!id || id.startsWith('local-')) {
      throw new Error(
        'Cannot approve a local workflow. Create the workflow through the backend first.'
      );
    }

    const combined = isCombinedWorkflow(workflow);

    let approvalBody: Record<string, any> =
      editedPayload || {};

    if (combined) {
      const payload = workflow?.payload as
        | Record<string, any>
        | undefined;

      approvalBody = {
        heading:
          editedPayload?.heading ??
          payload?.heading,

        description:
          editedPayload?.description ??
          payload?.description,

        key_points:
          editedPayload?.key_points ??
          payload?.key_points ??
          [],

        assignment_title:
          editedPayload?.assignment_title ??
          editedPayload?.title ??
          payload?.assignmentTitle,

        assignment_description:
          editedPayload?.assignment_description ??
          payload?.assignmentDescription,
      };
    }

    const basePath =
      getWorkflowBasePath(workflow);

    try {
      const response =
        await api.post<BackendWorkflow>(
          `${basePath}/${id}/approve`,
          approvalBody
        );

      if (!response.data?.id) {
        throw new Error(
          'Backend did not return the approved workflow.'
        );
      }

      return normalizeWorkflow(
        response.data,
        workflow
      );
    } catch (error) {
      console.error(
        `[WorkflowService] Approval failed for ${id}:`,
        error
      );

      throw error;
    }
  },

  /**
   * Reject a workflow and let the backend clean up its resources.
   */
  async rejectWorkflow(
    id: string,
    reason?: string,
    workflow?: Partial<WorkflowItem>
  ): Promise<WorkflowItem | undefined> {
    if (!id || id.startsWith('local-')) {
      throw new Error(
        'Cannot reject a local workflow. Create the workflow through the backend first.'
      );
    }

    const basePath =
      getWorkflowBasePath(workflow);

    try {
      const response =
        await api.post<BackendWorkflow>(
          `${basePath}/${id}/reject`,
          {
            reason: reason || 'Rejected by teacher',
          }
        );

      if (!response.data?.id) {
        throw new Error(
          'Backend did not return the rejected workflow.'
        );
      }

      return normalizeWorkflow(
        response.data,
        workflow
      );
    } catch (error) {
      console.error(
        `[WorkflowService] Rejection failed for ${id}:`,
        error
      );

      throw error;
    }
  },

  /**
   * Execute the approved workflow through the FastAPI backend.
   */
  async executeWorkflow(
    workflow: WorkflowItem,
    onProgress: (
      stepIndex: number,
      logMessage: string
    ) => void
  ): Promise<{
    success: boolean;
    verificationLog: ActivityLog;
    updatedWorkflow: WorkflowItem;
  }> {
    const workflowId = workflow.id;

    if (!workflowId) {
      throw new Error('Workflow ID is missing.');
    }

    if (workflowId.startsWith('local-')) {
      throw new Error(
        'This workflow is not connected to the MUAWIN backend. Please create a new workflow from the teacher instruction.'
      );
    }

    try {
      const combinedWorkflow =
        isCombinedWorkflow(workflow);

      const assignmentWorkflow =
        !combinedWorkflow &&
        isAssignmentWorkflow(workflow);

      const basePath =
        getWorkflowBasePath(workflow);

      const workflowLabel =
        combinedWorkflow
          ? 'COMBINED'
          : assignmentWorkflow
            ? 'ASSIGNMENT'
            : 'LECTURE';

      console.log(
        `[WorkflowService] Executing ${workflowLabel} workflow: ${workflowId}`
      );

      onProgress(
        0,
        'Executing approved MUAWIN workflow...'
      );

      onProgress(
        1,
        'Connecting to Moellim through controlled browser automation...'
      );

      onProgress(
        2,
        'Navigating to the target course and section...'
      );

      onProgress(
        3,
        combinedWorkflow
          ? 'Executing the approved lecture and assignment workflow...'
          : assignmentWorkflow
            ? 'Preparing the approved assignment creation...'
            : 'Preparing the approved lecture action...'
      );

      const response =
        await api.post<BackendWorkflow>(
          `${basePath}/${workflowId}/execute`
        );

      const backendWorkflow =
        response.data;

      if (!backendWorkflow?.id) {
        throw new Error(
          'Backend returned an empty execution response.'
        );
      }

      onProgress(
        4,
        combinedWorkflow
          ? 'Combined actions processed. Checking verification results...'
          : assignmentWorkflow
            ? 'Assignment action processed. Checking verification...'
            : 'Lecture action processed. Checking verification...'
      );

      const updatedWorkflow =
        normalizeWorkflow(
          backendWorkflow,
          workflow
        );

      const result = backendWorkflow.result;

      // Combined workflows may return separate lecture and assignment
      // results, so accept a verified result from either combined
      // structure as well as the top-level verified flag.
      const verified =
        result?.verified === true ||
        (
          combinedWorkflow &&
          (
            result?.lecture_result?.verified === true ||
            result?.assignment_result?.verified === true
          )
        );

      onProgress(
        5,
        verified
          ? 'Execution verified successfully on Moellim.'
          : backendWorkflow.status === 'completed'
            ? 'Execution completed. Review the returned verification details.'
            : 'Execution finished without confirmed verification.'
      );

      const nowStr =
        'Today, ' +
        new Date().toLocaleTimeString([], {
          hour: '2-digit',
          minute: '2-digit',
        });

      const resultCourse =
        result?.course ||
        backendWorkflow.course?.name ||
        workflow.courseName ||
        'Moellim';

      const resultMessage =
        result?.message ||
        (
          combinedWorkflow
            ? 'Combined workflow processed by controlled browser automation.'
            : assignmentWorkflow
              ? 'Assignment workflow processed by controlled browser automation.'
              : 'Lecture workflow processed by controlled browser automation.'
        );

      const logStatus: ActivityLog['status'] =
        verified
          ? 'Verified'
          : backendWorkflow.status === 'failed'
            ? 'Failed'
            : 'Pending';

      const verificationLog: ActivityLog = {
        id: 'log-' + Date.now(),

        timestamp: nowStr,

        courseCode:
          workflow.courseCode ||
          resultCourse,

        courseTitle:
          workflow.courseName ||
          resultCourse,

        action:
          combinedWorkflow
            ? 'Combined Workflow Executed'
            : assignmentWorkflow ||
                workflow.actionType === 'Create Assignment'
              ? 'Assignment Created'
              : 'Action Completed',

        workflowName:
          combinedWorkflow
            ? 'Combined Lecture and Assignment Workflow'
            : `${workflow.actionType} Workflow`,

        status: logStatus,

        operator:
          'Teacher (via MUAWIN)',

        details: resultMessage,

        moellimRef:
          `MOEL-${workflowId}`,
      };

      return {
        success:
          verified ||
          backendWorkflow.status === 'completed',
        verificationLog,
        updatedWorkflow,
      };
    } catch (error: any) {
      console.error(
        `[WorkflowService] Execution failed for ${workflowId}:`,
        error
      );

      onProgress(
        5,
        `Execution failed: ${
          error?.message || 'Unknown error'
        }`
      );

      throw error;
    }
  },
};

/**
 * Convenience exports used by the rest of the frontend.
 */
export const getWorkflows = () =>
  workflowService.getWorkflows();

export const getWorkflowById = (id: string) =>
  workflowService.getWorkflowById(id);

export const createWorkflow = (
  workflow: Partial<WorkflowItem>
) =>
  workflowService.createWorkflow(workflow);

export const approveWorkflow = (
  id: string,
  editedPayload?: WorkflowApprovalPayload,
  workflow?: Partial<WorkflowItem>
) =>
  workflowService.approveWorkflow(
    id,
    editedPayload,
    workflow
  );

export const rejectWorkflow = (
  id: string,
  reason?: string,
  workflow?: Partial<WorkflowItem>
) =>
  workflowService.rejectWorkflow(
    id,
    reason,
    workflow
  );

export default workflowService;
